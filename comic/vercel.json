{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/job.js": { "maxDuration": 300 },
    "api/render.js": { "maxDuration": 300 },
    "api/cron.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "*/5 * * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
