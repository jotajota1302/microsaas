{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cuento personalizado",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "dedication_hint",
    "character_sheet",
    "pages",
    "coloring_hints",
    "moral"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 6,
      "maxLength": 60,
      "description": "Story title in Spanish. May contain {{NOMBRE}}."
    },
    "dedication_hint": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140,
      "description": "One warm sentence for the title page, in Spanish."
    },
    "character_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appearance",
        "outfit",
        "companion"
      ],
      "properties": {
        "appearance": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300,
          "description": "English description of the child: age, hair, skin, glasses. No name."
        },
        "outfit": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "English description of the clothes, identical on every page."
        },
        "companion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "English description of the pet or friend, or null if there is none."
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "beat",
          "text",
          "image_hint"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "beat": {
            "enum": [
              "setup",
              "problem",
              "attempt",
              "resolution"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 200,
            "maxLength": 900,
            "description": "Spanish page text, 60-90 words, using {{NOMBRE}}."
          },
          "image_hint": {
            "type": "string",
            "minLength": 15,
            "maxLength": 240,
            "description": "English visual description of this page, max 30 words. No text, no signage."
          }
        }
      }
    },
    "coloring_hints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 200
      },
      "description": "Four scenes from this story, in English, to be turned into colouring pages."
    },
    "moral": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "The gentle idea the story carries, in Spanish. Never printed as a lesson."
    }
  }
}
