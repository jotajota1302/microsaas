# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Text generation (OpenRouter) -------------------------------------------
OPENROUTER_API_KEY=
TEXT_MODEL=google/gemini-2.5-flash-lite

# --- Image generation --------------------------------------------------------
# IMAGE_PROVIDER: seedream | nanobanana | minimax
IMAGE_PROVIDER=seedream
FAL_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# --- Data --------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Delivery ----------------------------------------------------------------
RESEND_API_KEY=
PUBLIC_BASE_URL=http://localhost:3000

# --- Print on demand ---------------------------------------------------------
GELATO_API_KEY=

# --- Ops ---------------------------------------------------------------------
ADMIN_TOKEN=
CRON_SECRET=
