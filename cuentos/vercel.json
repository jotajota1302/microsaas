{
  "functions": {
    "api/order.js": { "maxDuration": 60 },
    "api/flow.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 60 },
    "api/cron.js": { "maxDuration": 60 },
    "api/misc.js": { "maxDuration": 60 },
    "api/story.js": { "maxDuration": 30 },
    "api/webhook-stripe.js": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/c/:token", "destination": "/c/index.html" },
    { "source": "/api/revise", "destination": "/api/flow?fn=revise" },
    { "source": "/api/approve", "destination": "/api/flow?fn=approve" },
    { "source": "/api/checkout", "destination": "/api/flow?fn=checkout" },
    { "source": "/api/resume", "destination": "/api/flow?fn=resume" },
    { "source": "/api/config", "destination": "/api/misc?fn=config" },
    { "source": "/api/waitlist", "destination": "/api/misc?fn=waitlist" },
    { "source": "/api/print-interest", "destination": "/api/misc?fn=print-interest" },
    { "source": "/api/recover", "destination": "/api/misc?fn=recover" },
    { "source": "/api/job", "destination": "/api/misc?fn=job" }
  ],
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/colorear/(img|pdf)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=31536000, immutable" }
      ]
    }
  ]
}
