{
  "functions": {
    "api/order.js": {
      "maxDuration": 60
    },
    "api/revise.js": {
      "maxDuration": 60
    },
    "api/approve.js": {
      "maxDuration": 60
    },
    "api/job.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/c/:token",
      "destination": "/c/index.html"
    }
  ],
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/colorear/(img|pdf)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
